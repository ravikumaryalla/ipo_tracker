{
  "expo": {
    "name": "IPO Tracker",
    "slug": "ipo-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ipotracker",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ravikumar.ipotracker"
    },
    "android": {
      "package": "com.ravikumar.ipotracker",
      "adaptiveIcon": {
        "backgroundColor": "#070B14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow IPO Tracker to unlock your vault with Face ID."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#070B14"
        }
      ],
      "expo-splash-screen",
      "react-native-libsodium"
    ],
    "extra": {
      "eas": {
        "projectId": "e932c0a5-1397-47a7-845d-2027705a065f"
      },
      "router": {}
    },
    "owner": "ravikumaryallas-team"
  }
}
