# Copy to .env and fill in from your Supabase project settings -> API.
# Only the ANON key belongs here. It is safe to ship in the app because every
# table is protected by Row Level Security, and every secret is encrypted on the
# device before it is ever sent.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# NEVER put the service_role key in this file or anywhere in the app.
# It belongs only in Supabase secrets, used by the sync-ipos Edge Function:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
